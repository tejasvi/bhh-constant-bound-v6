/-
The g tables of track K (core Lean, kernel-friendly): the same values as the N-track tables `gtTab3/4/5`
(`Flt.buildTables`), packed in base 4 (entries are 2g values in {0, 1, 2}), so that the kernel looks an entry up with
one shift and one remainder.  Generated by an `#eval` of `gtTab3/4/5`.  Only
`gmin` matters for soundness (`GTabSound`, checked in BHH/GraphK.lean); `gmax` only steers the leaf function.
-/
import BHHCert.Leaf

namespace BHH.Cert

/-- entry `i` of a base-4 packed table -/
def tabGet (T : Nat) (i : Nat) : Int := (((T >>> (2 * i)) % 4 : Nat) : Int)

/-- packed `min` table, k = 3 -/
def tabMin3 : Nat :=
  134217728

/-- packed `max` table, k = 3 -/
def tabMax3 : Nat :=
  11434964549632000

/-- packed `min` table, k = 4 -/
def tabMin4 : Nat :=
  

/-- packed `max` table, k = 4 -/
def tabMax4 : Nat :=
  

/-- packed `min` table, k = 5 -/
def tabMin5 : Nat :=
  

/-- packed `max` table, k = 5 -/
def tabMax5 : Nat :=
  

/-- the g tables of track K -/
def gtK (k : Nat) : GTab :=
  match k with
  | 3 => ⟨tabGet tabMin3, tabGet tabMax3⟩
  | 4 => ⟨tabGet tabMin4, tabGet tabMax4⟩
  | _ => ⟨tabGet tabMin5, tabGet tabMax5⟩

end BHH.Cert
