/-
The kernel-only proof, K2 (standard axioms only): `MainBoundsK2`, `BetaBoundK2` and `BHHBetaBoundK2` from leaf
soundness of the kernel-side leaf function with the fast candidates (`leafSound_Kf_final`, BHH/LeafSound/FinalKf.lean) and
the kernel-checked trees of C_3 at the paper's parameters (4096 initial boxes) and of C_4 for the `4 0.4 0.002 3e-10`
tree (512 initial boxes) (`BHH/KSub2`, sub-box shards generated by tools/gen_kcut.py).
-/
import BHH.MainK
import BHH.BetaK2
import BHH.LeafSound.FinalKf
import BHH.KSub2.K3.Asm
import BHH.KSub2.K4.Asm

namespace BHH

open BHH.KC

/-- The kernel-only proof, K2: `C_3 ≥ 0.0117130195` and `C_4 ≥ 0.0059365909`. -/
theorem mainBoundsK2 : MainBoundsK2 := by
  intro hG hV
  have hp := BHH.E.piThreeHalvesLo_nonneg
  refine ⟨?_, ?_⟩
  · exact C_ge_of_rangeK (by norm_num) (BHH.KSub2.K3.range (leafSound_Kf_final hG hV 3 le_rfl (by norm_num)))
      (by positivity) kappa_three_gt.le (by norm_num [piThreeHalvesLo, BHH.KSub2.K3.S, BHH.Cert.OS])
  · exact C_ge_of_rangeK (by norm_num) (BHH.KSub2.K4.range (leafSound_Kf_final hG hV 4 (by norm_num) le_rfl))
      (by positivity) kappa_four_gt.le (by norm_num [piThreeHalvesLo, BHH.KSub2.K4.S, BHH.Cert.OS])

/-- The kernel-only proof, K2: `β ≥ 0.6426496` for every `β ≥ 5/8 + Σ_{k=3}^{30} C_k`. -/
theorem betaBoundK2 : BetaBoundK2 := betaBoundK2_of mainBoundsK2

/-- The kernel-only proof, K2, for the BHH constant (with the theorem of Dong and Cao as a hypothesis). -/
theorem bhhBetaBoundK2 : BHHBetaBoundK2 := bhhBetaBoundK2_of betaBoundK2

end BHH
